# ==============================================================================
# SPACEHUB UZ — ULTIMATE ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to `.env` or `.env.local` and configure for your environment.
# Never commit `.env` or expose secret keys to client bundles or git history.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SUPABASE (Hosted PostgreSQL, Auth, Storage, Realtime)
# ------------------------------------------------------------------------------
# Safe public Supabase browser configuration (available in client bundle)
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="eyJhbGciOi..."

# Server-only Supabase secret key; NEVER use in client components or client bundles
SUPABASE_SECRET_KEY="eyJhbGciOi..."

# Prisma connection strings (treat both as secrets)
# DATABASE_URL uses transaction pooling (port 6543)
DATABASE_URL="postgresql://postgres.your-project:password@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL uses direct connection for migrations (port 5432)
DIRECT_URL="postgresql://postgres.your-project:password@aws-0-region.pooler.supabase.com:5432/postgres"

# Development test flags
RUN_POSTGRES_TESTS="0"
SPACEHUB_DEV_SEED="0"

# ------------------------------------------------------------------------------
# 2. OPENAI (AI Concierge Responses API & Original Asset Generation)
# ------------------------------------------------------------------------------
# Server-only OpenAI API Key
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
OPENAI_IMAGE_MODEL="dall-e-3"
OPENAI_MAX_REQUESTS_PER_USER_PER_DAY="50"
OPENAI_MONTHLY_BUDGET_USD="50"

# ------------------------------------------------------------------------------
# 3. SMS & OTP (+998 Uzbekistan)
# ------------------------------------------------------------------------------
# Provider: 'simulator' (safe local dev/test) | 'eskiz' (Eskiz.uz provider)
SMS_PROVIDER="simulator"
SMS_PROVIDER_SECRET=""
ESKIZ_EMAIL=""
ESKIZ_PASSWORD=""
ESKIZ_FROM="SpaceHub"

# ------------------------------------------------------------------------------
# 4. PAYMENT GATEWAYS (UZS — Click & Payme)
# ------------------------------------------------------------------------------
CLICK_SERVICE_ID=""
CLICK_MERCHANT_ID=""
CLICK_SECRET_KEY=""
CLICK_MERCHANT_USER_ID=""

PAYME_MERCHANT_ID=""
PAYME_SECRET_KEY=""
PAYME_TEST_MODE="true"

# ------------------------------------------------------------------------------
# 5. TELEGRAM OPERATIONAL BOT
# ------------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=""
TELEGRAM_OWNER_CHAT_ID=""
TELEGRAM_WEBHOOK_SECRET=""

# ------------------------------------------------------------------------------
# 6. APPLICATION, MAPS & BACKGROUND WORKERS
# ------------------------------------------------------------------------------
APP_BASE_URL="http://localhost:3000"
MAPS_PROVIDER_KEY=""
CRON_JOB_SECRET=""
NODE_ENV="development"
