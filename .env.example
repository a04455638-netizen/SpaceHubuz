# ==============================================================================
# SPACEHUB UZ — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to `.env` and configure each section for your environment.
# Never commit `.env` or expose real secrets to client bundles or git history.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE (PostgreSQL & Prisma)
# ------------------------------------------------------------------------------
# PostgreSQL connection string with pooling or direct connection.
# Must have `btree_gist` extension enabled for interval exclusion constraints.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://spacehub:spacehub_secret@localhost:5432/spacehub_uz?schema=public"

# Enable to run database concurrency and exclusion constraint tests locally
RUN_POSTGRES_TESTS="0"

# Enable development test seed data (VENUE, RESOURCES, DEMO SLOTS)
# Only active in development/test environments
SPACEHUB_DEV_SEED="0"

# ------------------------------------------------------------------------------
# 2. APPLICATION & AUTHENTICATION
# ------------------------------------------------------------------------------
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Cryptographically secure secret (minimum 32 characters) for signing session cookies
SESSION_SECRET="replace-with-a-32-character-random-secret-for-session-encryption"

# Session expiration in seconds (default: 30 days = 2592000)
SESSION_MAX_AGE="2592000"

# ------------------------------------------------------------------------------
# 3. SMS & OTP VERIFICATION (+998 Uzbekistan)
# ------------------------------------------------------------------------------
# Provider: 'simulator' (safe local dev) | 'eskiz' (Eskiz.uz SMS provider)
OTP_PROVIDER="simulator"

# Eskiz SMS credentials (required only when OTP_PROVIDER="eskiz")
ESKIZ_EMAIL=""
ESKIZ_PASSWORD=""
ESKIZ_FROM="SpaceHub"

# ------------------------------------------------------------------------------
# 4. PAYMENT GATEWAYS (UZS — Click & Payme)
# ------------------------------------------------------------------------------
# Click Merchant Provider
CLICK_SERVICE_ID=""
CLICK_MERCHANT_ID=""
CLICK_SECRET_KEY=""
CLICK_MERCHANT_USER_ID=""

# Payme Merchant Provider (Paycom)
PAYME_MERCHANT_ID=""
PAYME_SECRET_KEY=""
PAYME_TEST_MODE="true"

# ------------------------------------------------------------------------------
# 5. TELEGRAM OPERATIONAL ALERTS BOT
# ------------------------------------------------------------------------------
# Telegram Bot API token for owner/admin operational alerts
TELEGRAM_BOT_TOKEN=""
TELEGRAM_WEBHOOK_SECRET=""
TELEGRAM_ADMIN_CHAT_ID=""

# ------------------------------------------------------------------------------
# 6. STORAGE (Supabase Storage or S3-compatible)
# ------------------------------------------------------------------------------
# Provider: 'local' (public upload folder) | 'supabase' | 's3'
STORAGE_PROVIDER="local"

# Supabase Storage credentials (when STORAGE_PROVIDER="supabase")
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="spacehub-media"
